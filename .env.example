# Use "mock" for a credential-free demo or "jev" for TypeSafe System One.
ANALYSIS_MODE=mock
TYPESAFE_API_KEY=typesafe_api_key_placeholder
TYPESAFE_MODEL=jev-1.13.0

# Short-lived OAuth access token for Android Publisher reviews.list.
# Production deployments should automate service-account/OAuth token rotation.
GOOGLE_PLAY_ACCESS_TOKEN=google_play_access_token_placeholder
GOOGLE_PLAY_MAX_PAGES=10

# Short-lived App Store Connect JWT.
# Production deployments should generate this from an App Store Connect key.
APPLE_APP_STORE_CONNECT_TOKEN=apple_app_store_connect_jwt_placeholder
APPLE_MAX_PAGES=10

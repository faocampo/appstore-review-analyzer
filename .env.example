# ---------------------------------------------------------------------------
# Access control (interim, until Loomit OIDC)
# ---------------------------------------------------------------------------
# Required in production: /api/analyze fails closed without it.
# Clients send "Authorization: Bearer <token>".
ANALYZE_API_TOKEN=
ANALYZE_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Classifier: openrouter (production default) | jev | mock (local default)
# ---------------------------------------------------------------------------
CLASSIFIER_PROVIDER=mock
CLASSIFIER_CONCURRENCY=
CLASSIFIER_MAX_RETRIES=2
CLASSIFIER_TIMEOUT_MS=

# OpenRouter: pin an explicit model id; there is no default model.
OPENROUTER_API_KEY=openrouter_api_key_placeholder
OPENROUTER_MODEL=
OPENROUTER_BATCH_SIZE=20
# Zero-data-retention routing. Data collection is always denied.
OPENROUTER_ZDR=true

# TypeSafe System One (Jev)
TYPESAFE_API_KEY=typesafe_api_key_placeholder
TYPESAFE_MODEL=jev-1.13.0

# ---------------------------------------------------------------------------
# Google Play: service account (recommended), minted server-side.
# Raw JSON or base64 JSON. Alternatively set GOOGLE_APPLICATION_CREDENTIALS
# to a key-file path. GOOGLE_PLAY_ACCESS_TOKEN is a manual fallback.
# ---------------------------------------------------------------------------
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_ACCESS_TOKEN=google_play_access_token_placeholder
GOOGLE_PLAY_MAX_PAGES=10

# ---------------------------------------------------------------------------
# App Store Connect: API key (recommended); ES256 JWT signed server-side.
# APPLE_PRIVATE_KEY is the .p8 PEM (newlines as \n) or base64 of it.
# APPLE_APP_STORE_CONNECT_TOKEN is a manual fallback.
# ---------------------------------------------------------------------------
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_STORE_CONNECT_TOKEN=apple_app_store_connect_jwt_placeholder
APPLE_MAX_PAGES=10

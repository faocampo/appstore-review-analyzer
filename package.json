{
  "name": "appstore-review-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tokens": "node scripts/generate-loomit-tokens.mjs",
    "build:server": "tsup",
    "start:api": "node dist/server/api.js",
    "start:worker": "node dist/server/worker.js",
    "migrate": "node dist/server/migrate.js",
    "dev:api": "tsx watch src/server/bin/api.ts",
    "dev:worker": "tsx watch src/server/bin/worker.ts",
    "dev:migrate": "tsx src/server/bin/migrate.ts",
    "dev:token": "tsx scripts/dev-token.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:agreement": "tsx scripts/eval-agreement.ts",
    "eval:smoke": "tsx scripts/eval.ts --dataset eval/datasets/sample.jsonl --provider mock",
    "backtest": "tsx scripts/backtest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/client-secrets-manager": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@fastify/cors": "11.4.1",
    "fastify": "5.12.8",
    "google-auth-library": "11.3.3",
    "hyparquet": "1.32.0",
    "hyparquet-writer": "0.18.0",
    "jose": "6.2.15",
    "next": "16.3.4",
    "papaparse": "5.5.3",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "prom-client": "15.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/papaparse": "5.3.16",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
